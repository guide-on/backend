<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.guideon.industry.code.mapper.IndustryCodeMapper">
    <sql id="whereSearch">
        WHERE ksic_code REGEXP '^[0-9]{5}$'
        <if test="code != null and code != ''">
            AND ksic_code LIKE CONCAT(#{code}, '%')   <!-- 코드 prefix -->
        </if>
        <if test="name != null and name != ''">
            AND name_kr LIKE CONCAT('%', #{name}, '%')<!-- 이름 부분일치 -->
        </if>
    </sql>

    <select id="selectKsic5Paged" resultType="com.guideon.industry.code.dto.Ksic5DTO">
        SELECT ksic_code AS code, name_kr AS name
        FROM industry_code
        <include refid="whereSearch"/>
        ORDER BY ksic_code ASC
        LIMIT #{offset}, #{amount}
    </select>

    <select id="countKsic5" resultType="int">
        SELECT COUNT(*)
        FROM industry_code
        <include refid="whereSearch"/>
    </select>
</mapper>