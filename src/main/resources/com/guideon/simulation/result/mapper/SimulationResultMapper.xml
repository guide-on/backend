<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guideon.simulation.result.mapper.SimulationResultMapper">

    <sql id="BaseColumns">
        session_id, member_id, fund_name,
        current_step, overall_status,
        started_at, updated_at,
        doc_session_status,
        total_credit_score, hybrid_credit_score, traditional_credit_score, credit_last_updated,
        plan_total_score,
        doc_score_pct, credit_score_pct, plan_score_pct, total_probability_pct
    </sql>

    <resultMap id="SimulationResultMap" type="com.guideon.simulation.result.domain.SimulationResult">
        <id     column="session_id"         property="sessionId"/>
        <result column="member_id"          property="memberId"/>
        <result column="fund_name"          property="fundName"/>
        <result column="current_step"       property="currentStep"
                javaType="com.guideon.simulation.result.enums.CurrentStep"/>
        <result column="overall_status"     property="overallStatus"
                javaType="com.guideon.simulation.result.enums.OverallStatus"/>
        <result column="started_at"         property="startedAt"/>
        <result column="updated_at"         property="updatedAt"/>

        <result column="doc_session_status" property="docSessionStatus"
                javaType="com.guideon.simulation.result.enums.DocSessionStatus"/>

        <result column="total_credit_score"       property="totalCreditScore"/>
        <result column="hybrid_credit_score"      property="hybridCreditScore"/>
        <result column="traditional_credit_score" property="traditionalCreditScore"/>
        <result column="credit_last_updated"      property="creditLastUpdated"/>

        <result column="plan_total_score"         property="planTotalScore"/>

        <result column="doc_score_pct"            property="docScorePct"/>
        <result column="credit_score_pct"         property="creditScorePct"/>
        <result column="plan_score_pct"           property="planScorePct"/>
        <result column="total_probability_pct"    property="totalProbabilityPct"/>
    </resultMap>

    <select id="countByMember" resultType="long">
        SELECT COUNT(*) FROM simulation_result WHERE member_id = #{memberId}
    </select>

    <select id="findPageByMember" resultMap="SimulationResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM simulation_result
        WHERE member_id = #{memberId}
        ORDER BY updated_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findBySessionIdAndMember" resultMap="SimulationResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM simulation_result
        WHERE session_id = #{sessionId} AND member_id = #{memberId}
        LIMIT 1
    </select>

    <select id="countInProgressByMember" resultType="long">
        SELECT COUNT(*) FROM simulation_result
        WHERE member_id = #{memberId} AND overall_status = 'IN_PROGRESS'
    </select>

    <select id="findLatestCompletedProbability" resultType="double">
        SELECT total_probability_pct
        FROM simulation_result
        WHERE member_id = #{memberId} AND overall_status = 'COMPLETED'
        ORDER BY updated_at DESC
            LIMIT 1
    </select>

    <update id="updatePlanResult">
        UPDATE simulation_result
        SET plan_total_score = #{planTotalScore},
            current_step = 'RESULT',
            overall_status = 'COMPLETED',
            updated_at = CURRENT_TIMESTAMP
        WHERE session_id = #{sessionId}
    </update>
</mapper>