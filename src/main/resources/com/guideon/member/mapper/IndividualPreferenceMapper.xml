<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.guideon.member.mapper.IndividualPreferenceMapper">
    <!-- 중복 키(PRIMARY KEY(member_id, sgg_code))일 때는 무시 -->
    <insert id="insertRegionBatch">
        INSERT IGNORE INTO individual_interest_region_map (member_id, sgg_code)
        VALUES
        <foreach collection="codes" item="c" separator=",">
            (#{memberId}, #{c})
        </foreach>
    </insert>

    <insert id="insertIndustryBatch">
        INSERT IGNORE INTO individual_interest_industry_map (member_id, ksic_code)
        VALUES
        <foreach collection="codes" item="c" separator=",">
            (#{memberId}, #{c})
        </foreach>
    </insert>
</mapper>